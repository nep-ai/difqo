{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--python", "3.13",
        "--from", "serena-agent==2.1.0",
        "serena", "start-mcp-server",
        "--context", "ide",
        "--agent-interface", "tools",
        "--project", "${workspaceFolder}",
        "--enable-web-dashboard", "false"
      ]
    },
    "agentation": {
      "type": "stdio",
      "command": "npx",
      "args": ["--yes", "agentation-mcp@1.3.2", "server", "--host", "127.0.0.1", "--port", "4748"],
      "env": { "AGENTATION_STORE": "memory" }
    }
  }
}
