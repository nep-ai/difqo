FROM difqo-codex:0.171.0
COPY codex-app-server.mjs /opt/difqo-smoke/codex-app-server.mjs
RUN mv /usr/local/bin/codex /usr/local/bin/codex-real \
    && printf '#!/bin/sh\nif [ "$1" = app-server ]; then exec node /opt/difqo-smoke/codex-app-server.mjs; fi\nexec /usr/local/bin/codex-real "$@"\n' > /usr/local/bin/codex \
    && chmod +x /usr/local/bin/codex
